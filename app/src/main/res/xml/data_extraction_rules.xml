<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cookies of the USOS sign-in WebView and the grades cache never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="grades.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="grades.json" />
    </device-transfer>
</data-extraction-rules>
